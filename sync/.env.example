# ---- Bling (API v3, OAuth 2.0) ----
# Credenciais do aplicativo cadastrado no Bling. NUNCA commitar o .env real.
BLING_CLIENT_ID=seu_client_id_aqui
BLING_CLIENT_SECRET=seu_client_secret_aqui
BLING_REDIRECT_URI=http://localhost:3000/callback

# Buscar detalhes de cada produto (marca, descrição completa, imagens).
# Mais lento (respeita 3 req/s), porém mais completo. true|false
SYNC_FETCH_DETAILS=true

# ---- Consultor virtual (IA) ----
# Chave da API da Anthropic — usada SOMENTE aqui no servidor, nunca no tablet.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo Claude usado pelo consultor (padrão: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8

# Porta do servidor do consultor/catálogo (o app aponta para http://IP_DO_PC:3001)
PORT=3001
